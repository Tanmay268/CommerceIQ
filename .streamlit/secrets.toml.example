# Template for Streamlit Community Cloud's Settings -> Secrets panel.
# Do NOT fill this file in and commit it -- .streamlit/secrets.toml is
# gitignored for that reason. Paste the filled-in contents directly into
# the app's Secrets panel on share.streamlit.io instead.

# Easiest: a single connection string from your hosted Postgres provider
# (Neon, Supabase, Railway, etc. all give you one of these).
DATABASE_URL = "postgresql+psycopg2://user:password@host:5432/dbname"

# Alternative: discrete vars (same ones used locally via .env), if you'd
# rather not use DATABASE_URL.
# POSTGRES_USER = "commerceiq"
# POSTGRES_PASSWORD = "change_me"
# POSTGRES_HOST = "host"
# POSTGRES_PORT = "5432"
# POSTGRES_DB = "commerceiq"
